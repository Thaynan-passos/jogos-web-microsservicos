# Serviços & Portas
USER_SERVICE_PORT=8001

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=user_db
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5432/user_db

# JWT
SECRET_KEY=replace-with-a-random-32-byte-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
