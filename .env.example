# Serviços & Portas
FRONTEND_PORT=5173
API_GATEWAY_PORT=8080
# JSON array com as origens autorizadas pelo CORS (ajuste para o domínio publicado).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Só habilite dados de demonstração em desenvolvimento local.
SEED_DEMO_DATA=false

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# Credenciais individuais dos bancos de cada serviço
USER_SERVICE_DB_PASSWORD=
GAME_SERVICE_DB_PASSWORD=
RANK_SERVICE_DB_PASSWORD=

# JWT
JWT_SECRET_KEY=
RECOVERY_TOKEN_SECRET_KEY=
RECOVERY_SERVICE_SECRET=
# SMTP para entrega dos tokens de recuperação fora do ambiente de desenvolvimento.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Somente para executar o User Service diretamente na máquina, fora do Compose.
POSTGRES_SERVER=localhost
DATABASE_URL=

# Use valores aleatórios e exclusivos. Não versione o arquivo .env preenchido.
