# Serviços & Portas
FRONTEND_PORT=5173
USER_SERVICE_PORT=8001
RANK_SERVICE_PORT=8003
RECOVERY_SERVICE_PORT=8004

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# Credenciais individuais dos bancos de cada serviço
USER_SERVICE_DB_PASSWORD=user_service_dev_password
GAME_SERVICE_DB_PASSWORD=game_service_dev_password
RANK_SERVICE_DB_PASSWORD=rank_service_dev_password

# JWT
SECRET_KEY=replace-with-a-random-32-byte-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Somente para executar o User Service diretamente na máquina, fora do Compose.
POSTGRES_SERVER=localhost
DATABASE_URL=postgresql+asyncpg://user_service:user_service_dev_password@localhost:5432/user_service

# Somente para desenvolvimento local. Troque todas as senhas antes de qualquer deploy.
